    },
    {
      "cell_type": "code",
      "source": [
        "df['total_stay'] = (\n",
        "    df['stays_in_weekend_nights'] +\n",
        "    df['stays_in_week_nights']\n",
        ")"
      ],
      "metadata": {
        "id": "pf8QvFZoOOdH"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df['arrival_month_num'] = pd.to_datetime(\n",
        "    df['arrival_date_month'],\n",
        "    format='%B'\n",
        ").dt.month"
      ],
      "metadata": {
        "id": "3gxLLUGcOQfb"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df['arrival_date'] = pd.to_datetime({\n",
        "    'year': df['arrival_date_year'],\n",
        "    'month': df['arrival_month_num'],\n",
        "    'day': df['arrival_date_day_of_month']\n",
        "})"
      ],
      "metadata": {
        "id": "h2eLMI8COSh1"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df['children'] = df['children'].fillna(0)\n",
        "\n",
        "df['is_family'] = np.where(\n",
        "    (df['adults'] > 1) &\n",
        "    ((df['children'] > 0) | (df['babies'] > 0)),\n",
        "    1,\n",
        "    0\n",
        ")"
      ],
      "metadata": {
        "id": "R-pkwIzEOVKh"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df['revenue'] = np.where(\n",
        "    df['is_canceled'] == 0,\n",
        "    df['adr'] * df['total_stay'],\n",
        "    0\n",
        ")"
      ],
      "metadata": {
        "id": "256lobisOXeI"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df['booker_type'] = np.where(\n",
        "    df['lead_time'] > 90,\n",
        "    'Early Planner',\n",
        "    np.where(\n",
        "        df['lead_time'] >= 30,\n",
        "        'Mid',\n",
        "        'Last Minute'\n",
        "    )\n",
        ")"
      ],
      "metadata": {
        "id": "JMeeu3lPOZl9"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(df[['total_stay',\n",
        "          'arrival_date',\n",
        "          'is_family',\n",
        "          'revenue',\n",
        "          'booker_type']].head())"
      ],
